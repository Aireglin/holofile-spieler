<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UfoEncounter</RootNamespace>
    <AssemblyName>UfoEncounter</AssemblyName>
    <!-- SimConnect (managed + native) is x64-only -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    Locate the MSFS SDK. Order of precedence:
      1. -p:MsfsSdkPath=... passed to dotnet build/publish
      2. MSFS2024_SDK environment variable (MSFS 2024)
      3. MSFS_SDK environment variable (legacy / MSFS 2020)
      4. Default install path
    Override on the command line if your SDK lives elsewhere.
  -->
  <PropertyGroup>
    <MsfsSdkPath Condition="'$(MsfsSdkPath)' == '' and '$(MSFS2024_SDK)' != ''">$(MSFS2024_SDK)</MsfsSdkPath>
    <MsfsSdkPath Condition="'$(MsfsSdkPath)' == '' and '$(MSFS_SDK)' != ''">$(MSFS_SDK)</MsfsSdkPath>
    <MsfsSdkPath Condition="'$(MsfsSdkPath)' == ''">C:\MSFS 2024 SDK</MsfsSdkPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Managed wrapper from the SDK -->
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(MsfsSdkPath)\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Native SimConnect.dll must sit next to the .exe at runtime -->
    <None Include="$(MsfsSdkPath)\SimConnect SDK\lib\SimConnect.dll"
          Condition="Exists('$(MsfsSdkPath)\SimConnect SDK\lib\SimConnect.dll')">
      <Link>SimConnect.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Holy Grail jumpscare clip. Git-ignored, so it is embedded only when
         present (AudioEngine falls back to the synthesized scare). Being inside
         the assembly it also works with PublishSingleFile. -->
    <None Remove="Assets\jumpscare.mp3" />
    <EmbeddedResource Include="Assets\jumpscare.mp3" LogicalName="UfoEncounter.Assets.jumpscare.mp3"
                      Condition="Exists('Assets\jumpscare.mp3')" />
  </ItemGroup>

  <Target Name="WarnIfSdkMissing" BeforeTargets="Build">
    <Warning Condition="!Exists('$(MsfsSdkPath)\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll')"
             Text="MSFS SDK not found at '$(MsfsSdkPath)'. Set MSFS2024_SDK or pass -p:MsfsSdkPath=... (see README)." />
  </Target>

</Project>
